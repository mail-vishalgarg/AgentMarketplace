# ── Anthropic ──────────────────────────────────────────────────────────────────
# Used by the builder and agent runtime to call Claude models
ANTHROPIC_API_KEY=sk-ant-replace-me

# ── Supabase ───────────────────────────────────────────────────────────────────
# Project URL shown in Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# anon/public key (safe for server-side calls behind RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-me
# service-role key (bypasses RLS — keep secret, backend only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-me

# ── Postgres ───────────────────────────────────────────────────────────────────
# Direct connection string for Alembic migrations and SQLAlchemy
DATABASE_URL=postgresql://postgres:password@localhost:5432/agentmarketplace

# ── Auth ───────────────────────────────────────────────────────────────────────
# Random 32+ char secret used to sign JWTs; generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-char-random-secret
JWT_ALGORITHM=HS256
# Token lifetime in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Redis ──────────────────────────────────────────────────────────────────────
# Used for LangGraph checkpoints, SSE pubsub, and Celery broker
REDIS_URL=redis://localhost:6379/0

# ── App ────────────────────────────────────────────────────────────────────────
# Set to "development" or "production"
APP_ENV=development
# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173
